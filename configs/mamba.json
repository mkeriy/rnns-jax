{
    "model": "Mamba",
    "model_params": {
        "num_layers": 1,
        "in_ftrs": 32,
        "hidden_ftrs": 128,
        "kernel_size": 4
    },
    "optimizer": "adam",
    "optimizer_params": {
        "learning_rate": 0.003
    },
    "lr_scheduler": {
        "init_value": 0.03,
        "end_value": 3e-4,
        "transition_steps": 13000,
        "transition_begin": 1000
    },
    "seed": 42,
    "batch_size": 64,
    "loss": "mse",
    "epochs": 1,
    "save_folder": <folder>,
    "data_path": "./datasets/subtrain.parquet",
    "evaluate": false,
    "test_path": "./datasets/test.parquet"
}