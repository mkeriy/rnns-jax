{
    "model": "blend",
    "model_params": {
        "out_ftrs": 32
    },
    "models": [
        {
            "model": "GRU",
            "model_params": {
                "in_ftrs": 32,
                "hidden_ftrs": 256,
                "out_ftrs": 32,
                "num_layers": 2,
                "bias": true
            },
            "ckpt": <path to ckpt>
        },
        {
            "model": "LSTM",
            "model_params": {
                "in_ftrs": 32,
                "hidden_ftrs": 256,
                "out_ftrs": 32,
                "num_layers": 2,
                "bias": true
            },
            "ckpt": <path to ckpt>
        }
    ],
    "optimizer": "Adam",
    "optimizer_params": {
        "learning_rate": 0.0003
    },
    "lr_scheduler": {
        "init_value": 0.003,
        "end_value": 0.00003,
        "transition_steps": 2000,
        "transition_begin": 250
    },
    "seed": 42,
    "batch_size": 16,
    "epochs": 2,
    "save_folder": <folder>,
    "data_path": "./datasets/test.parquet",
    "evaluate": false,
    "test_path": "./datasets/test.parquet"
}